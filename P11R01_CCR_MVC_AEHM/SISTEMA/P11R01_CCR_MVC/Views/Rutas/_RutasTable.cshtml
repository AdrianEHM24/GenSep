@model P11R01_CCR_MVC.Models.PagedResult<P11R01_CCR_MVC.Models.Rutas>

<div class="table-responsive shadow-sm rounded-3 bg-white">
    <table class="table table-striped table-hover align-middle mb-0" id="searchableTable">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().Origen)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().Destino)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().FechaSalida)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().FechaLlegada)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().ATiempo)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().Distancia)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().FechaRegistro)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().Camiones.Matricula)</th>
                <th>@Html.DisplayNameFor(model => model.Items.FirstOrDefault().Choferes.Nombre)</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                        No se encontraron rutas que coincidan con la búsqueda.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@Html.DisplayFor(modelItem => item.Origen)</td>
                        <td>@Html.DisplayFor(modelItem => item.Destino)</td>
                        <td>@Html.DisplayFor(modelItem => item.FechaSalida)</td>
                        <td>@Html.DisplayFor(modelItem => item.FechaLlegada)</td>
                        <td>
                            @if (item.ATiempo)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">A tiempo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">Con retraso</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Distancia)</td>
                        <td>@Html.DisplayFor(modelItem => item.FechaRegistro)</td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-dark px-2 py-1">
                                @Html.DisplayFor(modelItem => item.Camiones.Matricula)
                            </span>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Choferes.Nombre)</td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-2">
                                @Html.ActionLink(" Editar", "Edit", new { id = item.IdRuta }, new { @class = "btn-action-text btn-edit-text bi bi-pencil-square" })
                                @Html.ActionLink(" Detalles", "Details", new { id = item.IdRuta }, new { @class = "btn-action-text btn-details-text bi bi-eye-fill" })
                                @Html.ActionLink(" Eliminar", "Delete", new { id = item.IdRuta }, new { @class = "btn-action-text btn-delete-text bi bi-trash-fill" })
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Controles de Paginación Optimizados (ventana deslizante + flechas) -->
@if (Model.TotalPages > 1)
{
    int windowSize = 5;
    int startPage = Math.Max(1, Model.PageNumber - windowSize);
    int endPage = Math.Min(Model.TotalPages, Model.PageNumber + windowSize);

    <nav aria-label="Paginación de rutas" class="mt-4">
        <ul class="pagination justify-content-center mb-2 flex-wrap">

            <!-- Primera página -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a href="#" class="page-link page-link-ajax" data-page="1"
                   tabindex="@(Model.HasPreviousPage ? "0" : "-1")" title="Primera página">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>

            <!-- Anterior -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a href="#" class="page-link page-link-ajax" data-page="@(Model.PageNumber - 1)"
                   tabindex="@(Model.HasPreviousPage ? "0" : "-1")" title="Anterior">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            <!-- Primera página + elipsis -->
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a href="#" class="page-link page-link-ajax" data-page="1">1</a>
                </li>
                if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            <!-- Ventana de páginas -->
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a href="#" class="page-link page-link-ajax" data-page="@i">@i</a>
                </li>
            }

            <!-- Elipsis + última página -->
            @if (endPage < Model.TotalPages)
            {
                if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item">
                    <a href="#" class="page-link page-link-ajax" data-page="@Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            <!-- Siguiente -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a href="#" class="page-link page-link-ajax" data-page="@(Model.PageNumber + 1)"
                   tabindex="@(Model.HasNextPage ? "0" : "-1")" title="Siguiente">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>

            <!-- Última página -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a href="#" class="page-link page-link-ajax" data-page="@Model.TotalPages"
                   tabindex="@(Model.HasNextPage ? "0" : "-1")" title="Última página">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        </ul>

        <p class="text-center text-muted small mb-0">
            Mostrando @Model.Items.Count() de @Model.TotalItems.ToString("N0") registros
            (Página @Model.PageNumber.ToString("N0") de @Model.TotalPages.ToString("N0"))
        </p>
    </nav>
}
else
{
    <p class="text-center text-muted small mt-3 mb-0">
        Mostrando @Model.Items.Count() de @Model.TotalItems.ToString("N0") registros
    </p>
}