@model P11R01_CCR_MVC.Models.Rutas

@{
    ViewBag.Title = "Edit";
}

<div class="form-container-wrapper">
    <div class="form-card shadow-sm">
        <div class="form-header mb-4 pb-2 border-bottom">
            <h2 class="mb-1 text-gradient fw-bold">Editar Ruta</h2>
            <p class="text-muted mb-0">Modifica los campos necesarios para actualizar la información del trayecto.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })
                @Html.HiddenFor(model => model.IdRuta)

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.IdChofer, "Chofer", htmlAttributes: new { @class = "control-label" })
                            @Html.DropDownList("IdChofer", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.IdChofer, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.IdCamion, "Camión", htmlAttributes: new { @class = "control-label" })
                            @Html.DropDownList("IdCamion", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.IdCamion, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Origen, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.Origen, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Origen, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Destino, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.Destino, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Destino, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FechaSalida, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.FechaSalida, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FechaSalida, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FechaLlegada, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.FechaLlegada, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FechaLlegada, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Distancia, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.Distancia, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Distancia, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FechaRegistro, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.FechaRegistro, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FechaRegistro, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-4">
                        <div class="form-group form-check ps-0">
                            <label class="control-label d-flex align-items-center gap-2 cursor-pointer">
                                @Html.EditorFor(model => model.ATiempo)
                                <span class="fw-bold text-dark">Trayecto registrado a tiempo</span>
                            </label>
                            @Html.ValidationMessageFor(model => model.ATiempo, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>
                </div>

                <div class="form-actions-custom d-flex align-items-center gap-3 pt-3 border-top">
                    <input type="submit" value="Guardar Cambios" class="btn-success-custom shadow-sm bi bi-save-fill" />
                    @Html.ActionLink("Regresar a la lista", "Index", null, new { @class = "btn-secondary-custom bi bi-arrow-left" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}