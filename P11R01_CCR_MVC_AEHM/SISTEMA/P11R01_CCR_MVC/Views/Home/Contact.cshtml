@{
    ViewBag.Title = "Contacto";
}

<main aria-labelledby="title" class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-4">
                <h2 id="title" class="fw-bold text-dark mb-3">@ViewBag.Title</h2>
                <p class="text-muted mb-4">¿Tienes dudas, sugerencias o necesitas soporte con el sistema? Ponte en contacto con nosotros a través de los siguientes medios:</p>

                <!-- Correo Electrónico -->
                <div class="mb-4">
                    <h5 class="fw-bold text-primary"><i class="bi bi-envelope-fill"></i> Correo Electrónico</h5>
                    <p class="mb-1 text-secondary">Escríbenos directamente para consultas profesionales o soporte técnico:</p>
                    <a href="mailto:adrianeleuterio247518@gmail.com" class="text-decoration-none fw-bold fs-5">adrianeleuterio247518@gmail.com</a>
                </div>

                <hr class="text-muted">

                <!-- Redes Sociales y Comunicación -->
                <div class="mt-3">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-share-fill"></i> Redes Sociales y Canales de Contacto</h5>
                    <div class="d-flex flex-wrap gap-3">
                        <!-- WhatsApp -->
                        <a href="https://wa.me/" target="_blank" class="btn btn-success d-flex align-items-center gap-2">
                            <i class="bi bi-whatsapp"></i> WhatsApp
                        </a>
                        <!-- YouTube -->
                        <a href="https://www.youtube.com/" target="_blank" class="btn btn-danger d-flex align-items-center gap-2">
                            <i class="bi bi-youtube"></i> YouTube
                        </a>
                        <!-- Facebook -->
                        <a href="https://www.facebook.com/" target="_blank" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-facebook"></i> Facebook
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>