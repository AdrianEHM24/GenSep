<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema de Gestión de Logística</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/CCR-Estilos.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="bg-light">
    <!-- Navbar profesional con animaciones y estilo moderno -->
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark custom-navbar shadow-sm">
        <div class="container">
            @Html.ActionLink("Logística Integral", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold brand-animate" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link custom-nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", new { area = "" }, new { @class = "nav-link custom-nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contacto", "Contact", "Home", new { area = "" }, new { @class = "nav-link custom-nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Camiones", "Index", "Camiones", new { area = "" }, new { @class = "nav-link custom-nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Choferes", "Index", "Choferes", new { area = "" }, new { @class = "nav-link custom-nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Rutas", "Index", "Rutas", new { area = "" }, new { @class = "nav-link custom-nav-link" })</li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenedor principal -->
    <div class="container body-content my-4">
        @RenderBody()
        <hr />
        <footer class="text-center text-muted py-3">
            <p>&copy; @DateTime.Now.Year - Sistema de Gestión de Flotilla y Rutas. Todos los derechos reservados.</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>