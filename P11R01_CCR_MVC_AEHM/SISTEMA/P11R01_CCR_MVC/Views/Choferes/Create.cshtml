@model P11R01_CCR_MVC.Models.Choferes

@{
    ViewBag.Title = "Create";
}

<div class="form-container-wrapper">
    <div class="form-card shadow-sm">
        <div class="form-header mb-4 pb-2 border-bottom">
            <h2 class="mb-1 text-gradient fw-bold">Nuevo Chofer</h2>
            <p class="text-muted mb-0">Ingresa los datos para registrar un nuevo conductor en el sistema.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.ApPaterno, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.ApPaterno, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ApPaterno, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.ApMaterno, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.ApMaterno, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ApMaterno, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Telefono, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FechaNacimiento, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.FechaNacimiento, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FechaNacimiento, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Licencia, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.Licencia, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Licencia, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FechaRegistro, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.FechaRegistro, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FechaRegistro, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            @Html.LabelFor(model => model.UrlFoto, htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.UrlFoto, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.UrlFoto, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-4">
                        <div class="form-group form-check ps-0">
                            <label class="control-label d-flex align-items-center gap-2 cursor-pointer">
                                @Html.EditorFor(model => model.Disponibilidad)
                                <span class="fw-bold text-dark">Conductor disponible para ruta</span>
                            </label>
                            @Html.ValidationMessageFor(model => model.Disponibilidad, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>
                </div>

                <div class="form-actions-custom d-flex align-items-center gap-3 pt-3 border-top">
                    <input type="submit" value="Crear Chofer" class="btn-success-custom shadow-sm bi bi-check-circle-fill" />
                    @Html.ActionLink("Regresar a la lista", "Index", null, new { @class = "btn-secondary-custom bi bi-arrow-left" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}