@model P11R01_CCR_MVC.Models.Camiones

@{
    ViewBag.Title = "Delete";
}

<div class="form-container-wrapper">
    <div class="form-card shadow-sm border-danger border-opacity-25">
        <div class="form-header mb-4 pb-2 border-bottom">
            <h2 class="mb-1 text-danger fw-bold">Eliminar Camión</h2>
            <p class="text-muted mb-0">¿Estás seguro de que deseas eliminar este registro? Esta acción no se puede deshacer.</p>
        </div>

        <div class="details-list mb-4">
            <dl class="row g-3 mb-0">
                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Matricula)
                </dt>
                <dd class="col-sm-8 fw-bold text-dark">
                    @Html.DisplayFor(model => model.Matricula)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.TipoCamion)
                </dt>
                <dd class="col-sm-8 text-dark">
                    @Html.DisplayFor(model => model.TipoCamion)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Modelo)
                </dt>
                <dd class="col-sm-8 text-dark">
                    @Html.DisplayFor(model => model.Modelo)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Marca)
                </dt>
                <dd class="col-sm-8 text-dark">
                    @Html.DisplayFor(model => model.Marca)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Capacidad)
                </dt>
                <dd class="col-sm-8 text-dark">
                    @Html.DisplayFor(model => model.Capacidad)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Kilometraje)
                </dt>
                <dd class="col-sm-8 text-dark">
                    @Html.DisplayFor(model => model.Kilometraje)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.Disponibilidad)
                </dt>
                <dd class="col-sm-8 text-dark">
                    @Html.DisplayFor(model => model.Disponibilidad)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">
                    @Html.DisplayNameFor(model => model.UrlFoto)
                </dt>
                <dd class="col-sm-8 text-muted text-truncate" style="max-width: 350px;">
                    @Html.DisplayFor(model => model.UrlFoto)
                </dd>
            </dl>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions-custom d-flex align-items-center gap-3 pt-3 border-top">
                <input type="submit" value="Eliminar Camión" class="btn-danger-custom shadow-sm bi bi-trash-fill" />
                @Html.ActionLink("Regresar a la lista", "Index", null, new { @class = "btn-secondary-custom bi bi-arrow-left" })
            </div>
        }
    </div>
</div>